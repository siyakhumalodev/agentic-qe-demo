{
  "chat.subagents.showCreditUsage": true,
  "chat.subagents.useRichRendering": false,
  "github.copilot.chat.organizationCustomAgents.enabled": true,
  "chat.useAgentSkills": true,
  "chat.customAgentInSubagent.enabled": true,

  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests/unit", "tests/bdd"],

  "search.exclude": {
    "docs/DEMO-RUNBOOK.md": true,
    "docs/REHEARSAL-CHECKLIST.md": true,
    "runtime/**": true,
    ".venv/**": true
  },
  "files.watcherExclude": {
    "runtime/**": true,
    ".venv/**": true
  },
  "files.eol": "\n",
  "[powershell]": {
    "files.encoding": "utf8",
    "files.eol": "\r\n"
  }
}
